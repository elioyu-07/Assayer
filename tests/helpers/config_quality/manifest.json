{
  "pluginId": "test.config-quality",
  "version": "1.0.0",
  "platformApiVersion": "1.0.0",
  "compatibility": {
    "protocolMinVersion": "1.2.0",
    "protocolMaxVersion": "1.2.0",
    "sdkMinVersion": "0.1.2",
    "sdkMaxVersion": "0.1.2",
    "capabilities": [],
    "domainContractVersion": "1.0.0"
  },
  "domains": ["configuration-quality"],
  "subjectKinds": ["configuration_file"],
  "checks": [
    {
      "checkId": "CFG-001",
      "version": "1.0.0",
      "subjectKinds": ["configuration_file"],
      "dimensions": ["parseable", "required_keys", "value_types"],
      "decisionStates": ["issue_found", "scanned_no_issue", "needs_review"],
      "requiredEvidenceKinds": ["structured"],
      "requiredCapabilities": ["structured_read"],
      "capabilityMissingOutcome": "needs_review",
      "invalidationSignals": ["source_digest", "requirements_digest"]
    }
  ],
  "executionProfile": {
    "discoverBatching": "allowed",
    "inspectBatching": "allowed",
    "decisionBatching": "allowed",
    "parallelism": "forbidden",
    "cacheReuse": "allowed",
    "maxBatchSize": 32,
    "ordering": "independent",
    "failureSplitting": "allowed"
  }
}
