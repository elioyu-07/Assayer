{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/actionable-result.schema.json",
  "title": "AssayerActionableResultDelivery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "remediations"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "status": { "enum": ["complete", "partial"] },
    "remediations": {
      "type": "array",
      "items": { "$ref": "https://assayer.dev/schemas/actionable-result.schema.json#/$defs/remediation" }
    },
    "evidenceClaims": {
      "type": "array",
      "items": { "$ref": "evidence-claim.schema.json" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remediationId", "title", "severity", "dimensions",
        "affectedElements", "evidenceRefs", "problem", "impact",
        "recommendation", "nextAction", "closureEvidence", "owner"
      ],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
        "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
        "sourceRemediationId": { "$ref": "common.schema.json#/$defs/entityId" },
        "remediationId": { "$ref": "common.schema.json#/$defs/entityId" },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "severity": { "$ref": "common.schema.json#/$defs/severity" },
        "dimensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "affectedElements": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "evidenceRefs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/entityId" }
        },
        "claimRefs": {
          "type": "array", "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/entityId" }
        },
        "problem": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "impact": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "recommendation": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "nextAction": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "closureEvidence": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
      "owner": { "$ref": "https://assayer.dev/schemas/actionable-result.schema.json#/$defs/owner" }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["assigned", "unassigned", "external"] },
        "identity": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "assigned" } } },
          "then": { "required": ["identity"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["unassigned", "external"] } } },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
