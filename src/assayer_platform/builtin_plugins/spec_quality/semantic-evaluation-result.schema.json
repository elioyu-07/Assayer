{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/plugins/spec-quality/semantic-evaluation-result.schema.json",
  "title": "Spec Quality Semantic Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "passed", "metrics", "checks", "limitations"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "caseId": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedCandidateCount",
        "reviewedCandidateCount",
        "expectedFindingCount",
        "actualFindingCount"
      ],
      "properties": {
        "expectedCandidateCount": { "type": "integer", "minimum": 0 },
        "reviewedCandidateCount": { "type": "integer", "minimum": 0 },
        "expectedFindingCount": { "type": "integer", "minimum": 0 },
        "actualFindingCount": { "type": "integer", "minimum": 0 },
        "expectedRelationshipCount": { "type": "integer", "minimum": 0 },
        "actualRelationshipCount": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCoverage",
        "suppressions",
        "unverified",
        "findingClusters",
        "readiness"
      ],
      "properties": {
        "candidateCoverage": { "$ref": "#/$defs/idCheck" },
        "suppressions": { "$ref": "#/$defs/idCheck" },
        "unverified": { "$ref": "#/$defs/idCheck" },
        "findingClusters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "expected", "actual", "missing", "unexpected"],
          "properties": {
            "passed": { "type": "boolean" },
            "expected": { "$ref": "#/$defs/clusters" },
            "actual": { "$ref": "#/$defs/clusters" },
            "missing": { "$ref": "#/$defs/clusters" },
            "unexpected": { "$ref": "#/$defs/clusters" }
          }
        },
        "relationshipCoverage": { "$ref": "#/$defs/idCheck" },
        "relationshipOutcomes": { "$ref": "#/$defs/idCheck" },
        "semanticFindings": { "$ref": "#/$defs/semanticFindingCheck" },
        "documentContext": { "$ref": "#/$defs/valueCheck" },
        "checklistExpectations": { "$ref": "#/$defs/checklistExpectationCheck" },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "expected", "actual"],
          "properties": {
            "passed": { "type": "boolean" },
            "expected": { "$ref": "#/$defs/readiness" },
            "actual": { "$ref": "#/$defs/readiness" }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.1.0" } } },
      "then": {
        "properties": {
          "metrics": {
            "required": ["expectedRelationshipCount", "actualRelationshipCount"]
          },
          "checks": {
            "required": ["relationshipCoverage", "relationshipOutcomes", "semanticFindings"]
          }
        }
      }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "1.2.0" } } },
      "then": {
        "properties": {
          "checks": {
            "required": ["documentContext", "checklistExpectations"]
          }
        }
      }
    }
  ],
  "$defs": {
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "idCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expectedIds", "actualIds", "missingIds", "unexpectedIds"],
      "properties": {
        "passed": { "type": "boolean" },
        "expectedIds": { "$ref": "#/$defs/identifiers" },
        "actualIds": { "$ref": "#/$defs/identifiers" },
        "missingIds": { "$ref": "#/$defs/identifiers" },
        "unexpectedIds": { "$ref": "#/$defs/identifiers" }
      }
    },
    "valueCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "actual"],
      "properties": {
        "passed": { "type": "boolean" },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": ["string", "null"] }
      }
    },
    "checklistExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "applicability", "status"],
      "properties": {
        "checkId": { "pattern": "^CHK-(0[1-9]|1[0-8])$" },
        "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE", "CONDITIONAL", "UNVERIFIED"] },
        "status": { "enum": ["PASS", "REWORK", "ESCALATE", "UNVERIFIED"] }
      }
    },
    "checklistExpectations": {
      "type": "array",
      "items": { "$ref": "#/$defs/checklistExpectation" }
    },
    "checklistExpectationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "actual", "missing", "unexpected"],
      "properties": {
        "passed": { "type": "boolean" },
        "expected": { "$ref": "#/$defs/checklistExpectations" },
        "actual": { "$ref": "#/$defs/checklistExpectations" },
        "missing": { "$ref": "#/$defs/checklistExpectations" },
        "unexpected": { "$ref": "#/$defs/checklistExpectations" }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateIds", "severity"],
      "properties": {
        "candidateIds": { "$ref": "#/$defs/identifiers" },
        "severity": { "enum": ["P1", "P2", "P3"] }
      }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    },
    "semanticFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId", "semanticType", "status", "severity", "documentIds",
        "resolutionOwner"
      ],
      "properties": {
        "relationshipId": { "type": "string", "minLength": 1 },
        "semanticType": {
          "enum": ["ambiguity", "conflict", "contradiction", "drift", "unverified_dependency"]
        },
        "status": { "enum": ["CONFIRMED", "UNVERIFIED"] },
        "severity": {
          "oneOf": [
            { "enum": ["P1", "P2", "P3"] },
            { "type": "null" }
          ]
        },
        "documentIds": { "$ref": "#/$defs/identifiers" },
        "resolutionOwner": { "type": "string", "minLength": 1 }
      }
    },
    "semanticFindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/semanticFinding" }
    },
    "semanticFindingCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "actual", "missing", "unexpected"],
      "properties": {
        "passed": { "type": "boolean" },
        "expected": { "$ref": "#/$defs/semanticFindings" },
        "actual": { "$ref": "#/$defs/semanticFindings" },
        "missing": { "$ref": "#/$defs/semanticFindings" },
        "unexpected": { "$ref": "#/$defs/semanticFindings" }
      }
    },
    "readiness": {
      "enum": ["READY", "REWORK", "ESCALATE", "UNVERIFIED"]
    }
  }
}
