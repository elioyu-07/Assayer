      "expected": { "candidates": [{ "candidateId": "vague-32", "ruleId": "FR-006", "semanticType": "duplicate" }, { "candidateId": "vague-33", "ruleId": "FR-006", "semanticType": "duplicate" }], "suppressions": [], "merges": [{ "candidateIds": ["vague-32", "vague-33"], "findingId": "duplicate-root", "reason": "Both signals describe the same wording defect." }], "unverified": [], "findings": [{ "findingId": "duplicate-root", "semanticType": "duplicate", "severity": "P2", "candidateIds": ["vague-32", "vague-33"], "reason": "One duplicated non-verifiable requirement needs one remediation." }], "readiness": "REWORK" }
