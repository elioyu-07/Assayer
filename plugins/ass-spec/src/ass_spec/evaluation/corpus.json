      "description": "A vague quantity must be reviewed as ambiguity, not auto-confirmed.",
      "documents": [{ "documentId": "ambiguity-doc", "role": "input", "profile": "speckit", "path": "ambiguity.md" }],
      "expected": { "candidates": [{ "candidateId": "vague-30", "ruleId": "FR-006", "semanticType": "ambiguity" }], "suppressions": [], "merges": [], "unverified": [], "findings": [{ "findingId": "ambiguous-recency", "semanticType": "ambiguity", "severity": "P2", "candidateIds": ["vague-30"], "reason": "Recent and approximately all do not define a testable record boundary." }], "readiness": "REWORK" }
