      "expected": { "candidates": [{ "candidateId": "vague-31", "ruleId": "FR-006", "semanticType": "contradiction" }, { "candidateId": "vague-32", "ruleId": "FR-006", "semanticType": "contradiction" }], "suppressions": [], "merges": [], "unverified": [], "findings": [{ "findingId": "cancellation-owner-conflict", "semanticType": "contradiction", "severity": "P1", "candidateIds": ["vague-31", "vague-32"], "reason": "The same submitted request has two mutually exclusive cancellation owners." }], "readiness": "REWORK" }
