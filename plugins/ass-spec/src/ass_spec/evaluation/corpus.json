        "suppressions": [], "merges": [], "unverified": [],
        "findings": [
          { "findingId": "weak-structure", "semanticType": "missing", "severity": "P1", "candidateIds": ["requirements-missing", "acceptance-missing"], "reason": "Core behavior and acceptance are absent." },
          { "findingId": "weak-verifiability", "semanticType": "ambiguity", "severity": "P2", "candidateIds": ["vague-3"], "reason": "The target is not measurable." },
          { "findingId": "weak-scope", "semanticType": "missing", "severity": "P2", "candidateIds": ["scope-missing"], "reason": "The excluded scope is absent." },
          { "findingId": "weak-version", "semanticType": "missing", "severity": "P2", "candidateIds": ["metadata-missing"], "reason": "The reviewed version cannot be established." }
        ],
        "readiness": "REWORK"
      }
    },
    {
