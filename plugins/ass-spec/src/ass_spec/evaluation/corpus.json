      "category": "weak",
      "description": "An unfinished Spec should expose structural and testability gaps.",
      "documents": [{ "documentId": "weak-doc", "role": "input", "profile": "speckit", "path": "weak.md" }],
      "expected": {
        "candidates": [
          { "candidateId": "vague-3", "ruleId": "FR-006", "semanticType": "ambiguity" },
          { "candidateId": "requirements-missing", "ruleId": "FR-001", "semanticType": "missing" },
          { "candidateId": "acceptance-missing", "ruleId": "AC-001", "semanticType": "missing" },
          { "candidateId": "scope-missing", "ruleId": "SCOPE-001", "semanticType": "missing" },
          { "candidateId": "metadata-missing", "ruleId": "META-001", "semanticType": "missing" }
