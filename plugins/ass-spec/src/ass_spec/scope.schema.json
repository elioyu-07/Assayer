{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/plugins/ass-spec/scope.schema.json",
  "title": "Spec Quality Audit Scope",
  "description": "Select either independent Spec files or one anchor Spec with explicitly bounded related documents.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "anchor": { "$ref": "#/$defs/anchor" },
    "relatedDocuments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relatedDocument" }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "oneOf": [
    {
      "required": ["files"],
      "not": { "anyOf": [
        { "required": ["anchor"] },
        { "required": ["relatedDocuments"] },
        { "required": ["relationships"] }
      ] }
    },
    {
      "required": ["anchor", "relatedDocuments", "relationships"],
      "not": { "required": ["files"] }
    }
  ],
  "$defs": {
    "documentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "file": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 },
            "reviewStrategy": { "enum": ["candidate", "navigation"] }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "path"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "path": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "selectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "relatedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "path"],
      "properties": {
        "documentId": { "$ref": "#/$defs/documentId" },
        "path": { "type": "string", "minLength": 1 },
        "selectionReason": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipId", "fromDocumentId", "toDocumentId", "kind",
        "evidence", "resolutionOwner"
      ],
      "properties": {
        "relationshipId": { "$ref": "#/$defs/documentId" },
        "fromDocumentId": { "$ref": "#/$defs/documentId" },
        "toDocumentId": { "$ref": "#/$defs/documentId" },
        "kind": {
          "enum": ["authoritative_for", "implements", "depends_on", "supersedes", "compares_with"]
        },
        "evidence": { "type": "string", "minLength": 1 },
        "resolutionOwner": { "type": "string", "minLength": 1 },
        "selectionReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
