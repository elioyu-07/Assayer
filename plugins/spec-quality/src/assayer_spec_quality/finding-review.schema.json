{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/elioyu-07/spec-quality-audit/main/references/finding-review.schema.json",
  "title": "Spec Quality Audit Review Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_schema_version", "readiness_context", "decisions"],
  "properties": {
    "review_schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0"]},
    "document_context": {"$ref": "finding-model.schema.json#/$defs/documentContext"},
    "readiness_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatory_dimensions_checked", "unresolved_blockers", "escalations", "checklist_review"],
      "properties": {
        "mandatory_dimensions_checked": {"type": "boolean"},
        "unresolved_blockers": {"type": "boolean"},
        "escalations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "checklist_review": {
          "type": "array", "minItems": 18, "maxItems": 18,
          "items": {"$ref": "finding-model.schema.json#/$defs/checklistReview"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "finding-model.schema.json#/$defs/reviewed"}
    },
    "cross_document_review": {
      "type": "array",
      "items": {"$ref": "finding-model.schema.json#/$defs/crossDocumentReview"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_schema_version": {"enum": ["1.1.0", "1.2.0"]}}},
      "then": {
        "properties": {
          "readiness_context": {
            "properties": {
              "checklist_review": {
                "items": {"required": ["evidence_refs"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"review_schema_version": {"const": "1.3.0"}}},
      "then": {
        "required": ["document_context"],
        "properties": {
          "readiness_context": {
            "properties": {
              "checklist_review": {
                "items": {
                  "required": [
                    "applicability", "observation", "gap", "impact",
                    "recommendation", "owner", "next_action", "confidence"
                  ],
                  "allOf": [
                    {
                      "if": {"properties": {"status": {"const": "REWORK"}}},
                      "then": {"required": ["finding_refs"], "properties": {"finding_refs": {"minItems": 1}}}
                    }
                  ]
                }
              }
            }
          },
          "decisions": {
            "items": {
              "allOf": [
                {
                  "if": {"properties": {"status": {"const": "CONFIRMED"}}},
                  "then": {
                    "required": [
                      "observed_fact", "affected_elements", "owner",
                      "next_action", "confidence", "evidence_refs"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
