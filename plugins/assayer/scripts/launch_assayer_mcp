#!/bin/sh
set -eu

# The MCP hot path is intentionally lightweight. Runtime creation, offline
# package installation, and bundle integrity checks belong to
# prepare_assayer_runtime and are invoked explicitly by `assayer doctor --fix`.
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
MANIFEST="$PLUGIN_ROOT/.codex-plugin/plugin.json"

if [ ! -f "$MANIFEST" ]; then
  echo "ASSAYER_PLUGIN_INCOMPLETE: the plugin manifest is missing; reinstall the Assayer Codex Plugin." >&2
  exit 78
fi

PLUGIN_VERSION=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -n 1)
if [ -z "$PLUGIN_VERSION" ]; then
  echo "ASSAYER_PLUGIN_INCOMPLETE: the plugin version is unavailable; reinstall the Assayer Codex Plugin." >&2
  exit 78
fi
BASE_VERSION=${PLUGIN_VERSION%%+*}

if [ -n "${XDG_CACHE_HOME:-}" ]; then
  CACHE_ROOT=$XDG_CACHE_HOME
elif [ -n "${HOME:-}" ]; then
  CACHE_ROOT=$HOME/.cache
else
  echo "ASSAYER_CACHE_UNAVAILABLE: HOME or XDG_CACHE_HOME is required for the private runtime." >&2
  exit 78
fi

RUNTIME_ROOT="$CACHE_ROOT/assayer/runtime-$PLUGIN_VERSION"
MCP="$RUNTIME_ROOT/venv/bin/assayer-mcp"
IDENTITY="$RUNTIME_ROOT/runtime-identity.json"
if [ ! -x "$MCP" ] || [ ! -f "$RUNTIME_ROOT/bundle-ready" ] || [ ! -f "$IDENTITY" ]; then
  echo "ASSAYER_RUNTIME_NOT_READY: run 'assayer doctor --fix' once, then retry." >&2
  exit 78
fi
if ! grep -Fq "\"pluginVersion\": \"$PLUGIN_VERSION\"" "$IDENTITY" || \
   ! grep -Fq "\"runtimeVersion\": \"$BASE_VERSION\"" "$IDENTITY"; then
  echo "ASSAYER_RUNTIME_VERSION_MISMATCH: run 'assayer doctor --fix', then retry." >&2
  exit 78
fi

export ASSAYER_PLUGIN_VERSION="$PLUGIN_VERSION"
export ASSAYER_RUNTIME_VERSION="$BASE_VERSION"
export ASSAYER_BUNDLE_VERIFIED=1
exec "$MCP" --output-root "${ASSAYER_OUTPUT_ROOT:-${TMPDIR:-/tmp}/assayer-output}"
