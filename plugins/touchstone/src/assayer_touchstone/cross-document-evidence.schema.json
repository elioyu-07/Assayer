{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/plugins/touchstone/cross-document-evidence.schema.json",
  "title": "Spec Cross-document Evidence Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "evidence"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scope": { "$ref": "#/$defs/scope" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/evidenceItem" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "optionalText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id", "role", "path", "source_digest", "profile",
        "selection_reason"
      ],
      "properties": {
        "document_id": { "$ref": "#/$defs/identifier" },
        "role": { "enum": ["anchor", "related"] },
        "path": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "profile": { "$ref": "#/$defs/optionalText" },
        "selection_reason": { "$ref": "#/$defs/optionalText" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id", "from_document_id", "to_document_id", "kind",
        "evidence", "resolution_owner", "selection_reason"
      ],
      "properties": {
        "relationship_id": { "$ref": "#/$defs/identifier" },
        "from_document_id": { "$ref": "#/$defs/identifier" },
        "to_document_id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "enum": ["authoritative_for", "implements", "depends_on", "supersedes", "compares_with"]
        },
        "evidence": { "type": "string", "minLength": 1 },
        "resolution_owner": { "type": "string", "minLength": 1 },
        "selection_reason": { "$ref": "#/$defs/optionalText" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "anchor_document_id", "documents", "relationships"],
      "properties": {
        "kind": { "const": "cross-spec" },
        "anchor_document_id": { "$ref": "#/$defs/identifier" },
        "documents": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/$defs/document" }
        },
        "relationships": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_item_id", "relationship_id", "relationship_kind",
        "relationship_evidence", "resolution_owner", "selection_reason",
        "document_id", "document_role", "document_path", "source_digest",
        "source_chunk_id", "start_line", "end_line", "excerpt"
      ],
      "properties": {
        "evidence_item_id": { "type": "string", "minLength": 1 },
        "relationship_id": { "$ref": "#/$defs/identifier" },
        "relationship_kind": {
          "enum": ["authoritative_for", "implements", "depends_on", "supersedes", "compares_with"]
        },
        "relationship_evidence": { "type": "string", "minLength": 1 },
        "resolution_owner": { "type": "string", "minLength": 1 },
        "selection_reason": { "$ref": "#/$defs/optionalText" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "document_role": { "enum": ["anchor", "related"] },
        "document_path": { "type": "string", "minLength": 1 },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "source_chunk_id": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "excerpt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
