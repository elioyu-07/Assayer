{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/lifecycle-acceptance.schema.json",
  "title": "AssayerIsolatedLifecycleAcceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "publishable", "status"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "mode": { "const": "isolated_fake_codex" },
    "publishable": { "const": false },
    "status": { "enum": ["passed", "failed"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "planStatus", "transactionStatus"],
        "properties": {
          "operation": { "enum": ["upgrade", "rollback", "uninstall"] },
          "planStatus": { "const": "ready" },
          "transactionStatus": { "const": "completed" }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtimeRef"],
      "properties": {
        "status": { "const": "removed" },
        "runtimeRef": { "type": "string", "pattern": "^runtime-[0-9A-Za-z.+-]{1,128}$" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installedCount", "mutationCount"],
      "properties": {
        "installedCount": { "const": 0 },
        "mutationCount": { "type": "integer", "minimum": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "const": "ISOLATED_LIFECYCLE_ACCEPTANCE_FAILED" },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "required": ["steps", "cleanup", "catalog", "limitations"],
        "properties": { "steps": { "minItems": 3, "maxItems": 3 } },
        "not": { "required": ["result"] }
      }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "required": ["result"],
        "not": { "anyOf": [{ "required": ["steps"] }, { "required": ["cleanup"] }, { "required": ["catalog"] }] }
      }
    }
  ]
}
