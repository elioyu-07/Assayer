{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/plugin-release-acceptance.schema.json",
  "title": "AssayerPluginReleaseAcceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "status": { "const": "passed" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "checkVersion",
          "completedRuns",
          "domainResultSubmissions",
          "agentCorrections",
          "ledgerPaths",
          "resumeVerified",
          "replayVerified",
          "terminalPublicationVerified"
        ],
        "properties": {
          "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
          "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
          "completedRuns": { "type": "integer", "minimum": 1 },
          "domainResultSubmissions": { "type": "integer", "minimum": 1 },
          "agentCorrections": { "const": 0 },
          "ledgerPaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relativePath" }
          },
          "resumeVerified": { "const": true },
          "replayVerified": { "const": true },
          "terminalPublicationVerified": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
