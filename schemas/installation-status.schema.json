{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/installation-status.schema.json",
  "title": "AssayerInstallationStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "message", "identity", "python", "checks", "recentRuns", "feedback", "nextAction"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["healthy", "limited", "degraded"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageVersion", "pluginVersion", "runtimeVersion"],
      "properties": {
        "packageVersion": { "type": ["string", "null"], "maxLength": 128 },
        "pluginVersion": { "type": ["string", "null"], "maxLength": 128 },
        "runtimeVersion": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "platform"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "status": { "enum": ["pass", "warning", "fail"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "recentRuns": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "artifacts"],
        "properties": {
          "runId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,255}$" }
          }
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "include"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["runId", "artifacts"] }
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1, "maxLength": 512 }
  }
}
