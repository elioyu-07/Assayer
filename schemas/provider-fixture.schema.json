{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/provider-fixture.schema.json",
  "title": "AssayerProviderConformanceFixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "description", "capability", "scope", "sourceIdentity", "stateDigest", "expected"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "fixtureId": { "$ref": "common.schema.json#/$defs/entityId" },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
    "scope": { "type": "object" },
    "sourceIdentity": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "stateDigest": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["succeeded", "failed"] },
        "evidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "evidenceCount": { "type": "integer", "minimum": 1 },
        "failureCode": {
          "enum": ["capability_unavailable", "authorization_denied", "timeout", "budget_exceeded", "source_changed", "stale_state", "source_error", "result_unknown"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
          "then": { "required": ["evidenceKinds", "evidenceCount"], "not": { "required": ["failureCode"] } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "required": ["failureCode"], "not": { "required": ["evidenceKinds"] } }
        }
      ]
    }
  }
}
