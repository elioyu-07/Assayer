{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/provider-conformance.schema.json",
  "title": "AssayerProviderConformanceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "providers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "status": { "enum": ["passed", "failed"] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "providerId", "status", "issues"],
        "properties": {
          "schemaVersion": { "const": "1.0.0" },
          "providerId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "invariant", "message", "nextAction"],
              "properties": {
                "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
                "invariant": { "type": "string", "pattern": "^CPV1-[A-Z0-9-]+$" },
                "message": { "type": "string", "minLength": 1, "maxLength": 512 },
                "nextAction": { "type": "string", "minLength": 1, "maxLength": 512 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
            "then": { "properties": { "issues": { "maxItems": 0 } } }
          },
          {
            "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
            "then": { "properties": { "issues": { "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
