{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/provider-release.schema.json",
  "title": "AssayerProviderReleaseDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "providerVersion", "platformApiVersion", "registration", "providerDescriptor", "runtimeSource", "fixtures", "packageMetadata", "conformance"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "providerId": { "$ref": "common.schema.json#/$defs/entityId" },
    "providerVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "platformApiVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "registration": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "providerDescriptor": { "$ref": "#/$defs/relativePath" },
    "runtimeSource": { "$ref": "#/$defs/relativePath" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "packageMetadata": { "$ref": "#/$defs/relativePath" },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion"],
      "properties": {
        "contractVersion": { "const": "1.0.0" }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
