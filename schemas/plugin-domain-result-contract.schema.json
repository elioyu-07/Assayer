{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/plugin-domain-result-contract.schema.json",
  "title": "AssayerPluginDomainResultContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "checkId",
    "checkVersion",
    "schemaDialect",
    "inputKind",
    "resultSchema",
    "semanticInstructions"
  ],
  "properties": {
    "contractId": { "$ref": "common.schema.json#/$defs/entityId" },
    "contractVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "checkId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$" },
    "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "schemaDialect": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "inputKind": { "const": "domainResult" },
    "resultSchema": { "type": "object" },
    "semanticRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "instruction"],
        "properties": {
          "ruleId": { "$ref": "common.schema.json#/$defs/entityId" },
          "instruction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semanticInstructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "contractDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
