{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/run-diagnostics.schema.json",
  "title": "RunDiagnostics",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "sourceLedger", "sourceLedgerDigest", "scanId", "runId", "scanStatus", "conclusionsValid", "terminalReason", "coverageProof", "assessmentResultCounts", "failedOperations"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" }, "sourceLedger": { "const": "audit-ledger.json" }, "sourceLedgerDigest": { "$ref": "common.schema.json#/$defs/sha256" }, "scanId": { "$ref": "common.schema.json#/$defs/entityId" }, "runId": { "$ref": "common.schema.json#/$defs/entityId" }, "scanStatus": { "enum": ["completed", "partial", "failed"] }, "conclusionsValid": { "type": "boolean" }, "terminalReason": { "$ref": "common.schema.json#/$defs/reason" }, "coverageProof": { "type": "object" }, "assessmentResultCounts": { "type": "object", "required": ["issue_found", "scanned_no_issue", "not_applicable", "needs_review", "noise"], "additionalProperties": { "type": "integer", "minimum": 0 } }, "failedOperations": { "type": "array", "items": { "type": "object", "required": ["operationId", "tool", "status"], "properties": { "operationId": { "$ref": "common.schema.json#/$defs/entityId" }, "tool": { "type": "string" }, "status": { "type": "string" }, "reason": { "$ref": "common.schema.json#/$defs/reason" } } } }, "assessmentTimelines": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["assessmentId", "result", "decidedAt", "preparationOperationRef", "commitOperationRef", "findingRefs", "evidenceRefs", "caseRefs"], "properties": { "assessmentId": { "$ref": "common.schema.json#/$defs/entityId" }, "result": { "$ref": "common.schema.json#/$defs/decisionResult" }, "decidedAt": { "$ref": "common.schema.json#/$defs/timestamp" }, "preparationOperationRef": { "$ref": "common.schema.json#/$defs/entityId" }, "commitOperationRef": { "$ref": "common.schema.json#/$defs/entityId" }, "findingRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" } }, "evidenceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" } }, "caseRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" } } } } }, "attributions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["layer", "confidence", "reason", "recommendation"], "properties": { "layer": { "enum": ["environment", "browser_adapter", "host_contract", "agent_strategy", "rule_contract", "transport_runtime", "target_application", "unattributed"] }, "confidence": { "enum": ["high", "medium", "low"] }, "reason": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 }, "operationRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" } }, "eventRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" } } } } }
  }
}
