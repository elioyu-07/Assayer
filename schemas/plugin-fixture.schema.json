{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/plugin-fixture.schema.json",
  "title": "AssayerPluginConformanceFixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "checkId", "description", "scope", "expected"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "fixtureId": { "$ref": "common.schema.json#/$defs/entityId" },
    "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
    "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "scope": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalStatus"],
      "properties": {
        "terminalStatus": { "enum": ["completed", "partial", "failed"] },
        "decisionResults": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/decisionResult" }
        },
        "failureCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "terminalStatus": { "const": "failed" } } },
          "then": { "required": ["failureCodes"] },
          "else": { "required": ["decisionResults"] }
        }
      ]
    }
  }
}
