{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/runtime-event.schema.json",
  "title": "RuntimeEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId", "scanId", "runId", "sequence", "occurredAt", "monotonicOffsetMs",
    "source", "category", "name", "phase", "severity", "outcome", "summary",
    "privacy", "attributes"
  ],
  "properties": {
    "eventId": { "$ref": "common.schema.json#/$defs/entityId" },
    "scanId": { "$ref": "common.schema.json#/$defs/entityId" },
    "runId": { "$ref": "common.schema.json#/$defs/entityId" },
    "sequence": { "type": "integer", "minimum": 1 },
    "occurredAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "monotonicOffsetMs": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["agent", "model", "transport", "router", "host", "browser", "recovery", "reporter"] },
    "category": { "enum": ["lifecycle", "decision", "tool", "browser", "network", "safety", "recovery", "lease", "model", "integrity"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,95}$" },
    "phase": { "enum": ["instant", "start", "finish"] },
    "severity": { "enum": ["debug", "info", "warning", "error", "fatal"] },
    "outcome": { "enum": ["started", "succeeded", "rejected", "blocked", "failed", "unknown", "not_exposed"] },
    "summary": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        { "maxLength": 1024 }
      ]
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentTurnId": { "$ref": "common.schema.json#/$defs/entityId" },
        "requestId": { "$ref": "common.schema.json#/$defs/entityId" },
        "operationId": { "$ref": "common.schema.json#/$defs/entityId" },
        "pageStateRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "entrypointRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "objectRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "caseRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "findingRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "findingRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/entityId" }
        },
        "assessmentRef": { "$ref": "common.schema.json#/$defs/entityId" },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/entityId" }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "sanitizationStatus"],
      "properties": {
        "classification": { "enum": ["public", "internal", "sensitive_metadata"] },
        "sanitizationStatus": { "enum": ["not_required", "sanitized", "redacted", "dropped"] },
        "policyVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" }
      }
    },
    "attributes": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "allOf": [
          { "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          {
            "not": {
              "enum": [
                "prompt", "messages", "chainOfThought", "hiddenReasoning", "credential",
                "password", "secret", "cookie", "authorization", "dom", "html",
                "requestBody", "responseBody", "userValue", "screenshotBase64"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "maxLength": 1024 },
          { "type": "integer" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" },
          { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "finish" } }, "required": ["phase"] },
      "then": { "required": ["durationMs"] }
    },
    {
      "if": { "properties": { "category": { "enum": ["decision", "tool"] } }, "required": ["category"] },
      "then": { "required": ["correlation"] }
    }
  ]
}
