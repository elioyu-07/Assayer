{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-f.dev/schemas/protocol/tool-contracts.schema.json",
  "title": "agent-f tool input and output contracts",
  "description": "工具专用参数的机器约束；封套约束由 envelope.schema.json 拥有。",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "input", "output"],
  "properties": {
    "tool": { "enum": ["start_audit", "inspect_page", "inspect_object", "begin_case", "perform_action", "restore_case", "inspect_source", "capture_evidence", "prepare_decision", "commit_decision", "get_operation", "complete_audit"] },
    "input": { "type": "object" },
    "output": { "type": "object" }
  },
  "$defs": {
    "id": { "$ref": "../common.schema.json#/$defs/entityId" },
    "rule": { "$ref": "../common.schema.json#/$defs/ruleRef" },
    "reason": { "$ref": "../common.schema.json#/$defs/reason" },
    "pageStateId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "objectId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "caseId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "operationId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "actionType": { "enum": ["scroll", "focus", "expand", "collapse", "switch_tab", "open_detail", "close_detail", "open_edit", "close_overlay", "input_synthetic_value", "restore_value", "refresh"] },
    "decisionResult": { "$ref": "../common.schema.json#/$defs/decisionResult" },
    "commonOutput": {
      "type": "object",
      "required": ["operationId", "runRevision"],
      "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "runRevision": { "$ref": "../common.schema.json#/$defs/runRevision" }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "diagnosticRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "startAuditInput": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "ruleRegistryVersion", "outputDir", "browserProfile", "credentialHandle"],
      "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "sourcePath": { "type": "string", "minLength": 1 }, "ruleRegistryVersion": { "$ref": "../common.schema.json#/$defs/semanticVersion" }, "outputDir": { "type": "string", "minLength": 1 }, "browserProfile": { "type": "string", "minLength": 1 }, "credentialHandle": { "$ref": "#/$defs/id" } }
    },
    "startAuditOutput": {
      "type": "object", "unevaluatedProperties": false,
      "required": ["operationId", "runRevision", "scanId", "runId", "loginStatus", "ruleRegistryDigest", "capabilities"],
      "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "runRevision": { "$ref": "../common.schema.json#/$defs/runRevision" }, "scanId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "loginStatus": { "enum": ["pending", "succeeded", "failed"] }, "currentPageStateId": { "$ref": "#/$defs/pageStateId" }, "ruleRegistryDigest": { "$ref": "../common.schema.json#/$defs/sha256" }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "diagnosticRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } },
      "allOf": [{ "if": { "properties": { "loginStatus": { "const": "succeeded" } }, "required": ["loginStatus"] }, "then": { "required": ["currentPageStateId"] } }]
    },
    "inspectPageInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "include"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["route", "visibleText", "objects", "safeEntrypoints", "networkSummary"] } } } },
    "inspectPageOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["pageStateId", "candidateRefs", "entrypointRefs"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "candidateRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "entrypointRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "route": { "type": "string" }, "title": { "type": "string" }, "visibleText": { "type": "string" }, "networkSummary": { "type": "object" } } },
    "inspectObjectInput": { "type": "object", "additionalProperties": false, "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "candidateId": { "$ref": "#/$defs/id" } }, "oneOf": [{ "required": ["objectId"] }, { "required": ["candidateId"] }] },
    "inspectObjectOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }, { "if": { "properties": { "rebindStatus": { "const": "matched" } }, "required": ["rebindStatus"] }, "then": { "required": ["objectId"] } }, { "if": { "properties": { "rebindStatus": { "const": "changed" } }, "required": ["rebindStatus"] }, "then": { "required": ["replacementCandidateRef"] } }], "required": ["verificationRef", "rebindStatus", "candidateCount", "matchedDimensions", "changedDimensions"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "replacementCandidateRef": { "$ref": "#/$defs/id" }, "verificationRef": { "$ref": "#/$defs/id" }, "rebindStatus": { "enum": ["matched", "not_found", "ambiguous", "changed"] }, "candidateCount": { "type": "integer", "minimum": 0 }, "matchedDimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "changedDimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "beginCaseInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "rule", "kind", "purpose", "plannedCoverageDimensions"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "rule": { "$ref": "#/$defs/rule" }, "kind": { "enum": ["negative", "boundary", "invalid", "exception", "happy_prerequisite", "observation"] }, "purpose": { "type": "string", "minLength": 1 }, "plannedCoverageDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "syntheticInputs": { "type": "array", "items": { "type": "object" } } } },
    "beginCaseOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["caseId", "baselinePageStateRef", "status"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "baselinePageStateRef": { "$ref": "#/$defs/pageStateId" }, "status": { "const": "planned" } } },
    "performActionInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "caseId", "objectId", "type", "intent", "parameters"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "caseId": { "$ref": "#/$defs/caseId" }, "objectId": { "$ref": "#/$defs/objectId" }, "type": { "$ref": "#/$defs/actionType" }, "intent": { "type": "string", "minLength": 1 }, "parameters": { "type": "object" } } },
    "performActionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["beforePageStateRef", "afterPageStateRef"], "properties": { "beforePageStateRef": { "$ref": "#/$defs/pageStateId" }, "afterPageStateRef": { "$ref": "#/$defs/pageStateId" }, "resultStatus": { "enum": ["succeeded", "rejected", "result_unknown"] } } },
    "restoreCaseInput": { "type": "object", "additionalProperties": false, "required": ["caseId", "pageStateId", "objectId", "fallback"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "pageStateId": { "$ref": "#/$defs/pageStateId" }, "objectId": { "$ref": "#/$defs/objectId" }, "fallback": { "const": "refresh_and_replay_safe_entrypoints" } } },
    "restoreCaseOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["caseId", "finalStatus"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "finalStatus": { "enum": ["restored", "uncertain", "failed"] } } },
    "inspectSourceInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "queries", "maxSnippets"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "queries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "maxSnippets": { "type": "integer", "minimum": 1, "maximum": 32 } } },
    "inspectSourceOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["sourceBindingStatus"], "properties": { "sourceBindingStatus": { "enum": ["verified", "unverified", "not_found"] }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "captureEvidenceInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "objectId"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "objectId": { "$ref": "#/$defs/objectId" }, "caseId": { "$ref": "#/$defs/caseId" }, "includeRawVisual": { "type": "boolean" } } },
    "captureEvidenceOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["evidenceId"], "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "screenshotRef": { "$ref": "#/$defs/id" } } },
    "prepareDecisionInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "rule", "result", "reasonText", "evidenceRefs", "caseRefs"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "rule": { "$ref": "#/$defs/rule" }, "result": { "$ref": "#/$defs/decisionResult" }, "reasonText": { "type": "string", "minLength": 1 }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "caseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/caseId" } }, "rawVisualRef": { "$ref": "#/$defs/id" }, "severity": { "$ref": "../common.schema.json#/$defs/severity" }, "title": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "result": { "const": "issue_found" } }, "required": ["result"] }, "then": { "required": ["severity", "title", "message", "impact", "recommendation"] } }] },
    "prepareDecisionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["pendingDecisionId"], "properties": { "pendingDecisionId": { "$ref": "#/$defs/id" }, "screenshotRef": { "$ref": "#/$defs/id" } } },
    "commitDecisionInput": { "type": "object", "additionalProperties": false, "required": ["pendingDecisionId"], "properties": { "pendingDecisionId": { "$ref": "#/$defs/id" } } },
    "commitDecisionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["assessmentId"], "properties": { "assessmentId": { "$ref": "#/$defs/id" }, "issueId": { "$ref": "#/$defs/id" } } },
    "getOperationInput": { "type": "object", "additionalProperties": false, "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/operationId" } } },
    "getOperationOutput": { "type": "object", "additionalProperties": false, "required": ["operationId", "status", "requestDigest"], "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "status": { "enum": ["accepted", "running", "succeeded", "rejected", "failed_known", "result_unknown"] }, "requestDigest": { "$ref": "../common.schema.json#/$defs/sha256" }, "resultEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "completeAuditInput": { "type": "object", "additionalProperties": false, "required": ["visitedPageStateRefs", "processedObjectRefs", "processedEntrypointRefs", "skippedEntrypoints", "ruleSummaries", "unprocessedEntrypointRefs", "completionReason"], "properties": { "visitedPageStateRefs": { "type": "array", "items": { "$ref": "#/$defs/pageStateId" } }, "processedObjectRefs": { "type": "array", "items": { "$ref": "#/$defs/objectId" } }, "processedEntrypointRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "skippedEntrypoints": { "type": "array", "items": { "type": "object" } }, "ruleSummaries": { "type": "array", "items": { "type": "object" } }, "unprocessedEntrypointRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "completionReason": { "type": "string", "minLength": 1 } } },
    "completeAuditOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["scanStatus", "conclusionsValid"], "properties": { "scanStatus": { "enum": ["completed", "partial", "failed"] }, "conclusionsValid": { "type": "boolean" } } }
  }
}
