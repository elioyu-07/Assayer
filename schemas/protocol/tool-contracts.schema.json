{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/protocol/tool-contracts.schema.json",
  "title": "Assayer tool input and output contracts",
  "description": "工具专用参数的机器约束；封套约束由 envelope.schema.json 拥有。",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "input", "output"],
  "properties": {
    "tool": { "enum": ["start_audit", "get_rule_contract", "get_audit_progress", "inspect_page", "explore_entrypoint", "inspect_object", "begin_case", "perform_action", "restore_case", "inspect_source", "capture_evidence", "record_findings", "prepare_decision", "commit_decision", "get_operation", "complete_audit"] },
    "input": { "type": "object" },
    "output": { "type": "object" }
  },
  "$defs": {
    "id": { "$ref": "../common.schema.json#/$defs/entityId" },
    "rule": { "$ref": "../common.schema.json#/$defs/ruleRef" },
    "reason": { "$ref": "../common.schema.json#/$defs/reason" },
    "pageStateId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "objectId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "caseId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "operationId": { "$ref": "../common.schema.json#/$defs/entityId" },
    "actionType": { "enum": ["scroll", "focus", "expand", "collapse", "switch_tab", "open_detail", "close_detail", "open_edit", "close_overlay", "input_synthetic_value", "restore_value", "refresh"] },
    "decisionResult": { "$ref": "../common.schema.json#/$defs/decisionResult" },
    "commonOutput": {
      "type": "object",
      "required": ["operationId", "runRevision"],
      "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "runRevision": { "$ref": "../common.schema.json#/$defs/runRevision" }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "diagnosticRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
    },
    "startAuditInput": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "ruleRegistryVersion", "outputDir", "browserProfile"],
      "properties": { "url": { "type": "string", "format": "uri", "pattern": "^https?://" }, "sourcePath": { "type": "string", "minLength": 1 }, "ruleRegistryVersion": { "$ref": "../common.schema.json#/$defs/semanticVersion" }, "outputDir": { "type": "string", "minLength": 1 }, "browserProfile": { "type": "string", "minLength": 1 }, "authMode": { "enum": ["credential", "anonymous"] }, "credentialHandle": { "$ref": "#/$defs/id" } },
      "allOf": [
        { "if": { "properties": { "authMode": { "const": "anonymous" } }, "required": ["authMode"] },
          "then": { "not": { "required": ["credentialHandle"] } },
          "else": { "required": ["credentialHandle"] } }
      ]
    },
    "startAuditOutput": {
      "type": "object", "unevaluatedProperties": false,
      "required": ["operationId", "runRevision", "scanId", "runId", "loginStatus", "ruleRegistryDigest", "capabilities", "frozenRules"],
      "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "runRevision": { "$ref": "../common.schema.json#/$defs/runRevision" }, "scanId": { "$ref": "#/$defs/id" }, "runId": { "$ref": "#/$defs/id" }, "loginStatus": { "enum": ["pending", "succeeded", "failed"] }, "currentPageStateId": { "$ref": "#/$defs/pageStateId" }, "ruleRegistryDigest": { "$ref": "../common.schema.json#/$defs/sha256" }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "frozenRules": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["ruleId", "version", "objectKinds", "coverageDimensions"], "properties": { "ruleId": { "type": "string" }, "version": { "type": "string" }, "objectKinds": { "type": "array", "items": { "type": "string" } }, "coverageDimensions": { "type": "array", "items": { "type": "string" } } } } }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "diagnosticRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } },
      "allOf": [{ "if": { "properties": { "loginStatus": { "const": "succeeded" } }, "required": ["loginStatus"] }, "then": { "required": ["currentPageStateId"] } }]
    },
    "inspectPageInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "include"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "include": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["route", "visibleText", "objects", "safeEntrypoints", "networkSummary"] } } } },
    "inspectPageOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["pageStateId", "candidateRefs", "entrypointRefs", "entrypoints"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "candidateRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "entrypointRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "entrypoints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["entrypointId", "kind", "label", "status"], "properties": { "entrypointId": { "$ref": "#/$defs/id" }, "kind": { "type": "string" }, "label": { "type": "string" }, "status": { "type": "string" } } } }, "route": { "type": "string" }, "title": { "type": "string" }, "activeTab": { "type": "string" }, "structureSummary": { "type": "object" }, "visibleText": { "type": "string" }, "networkSummary": { "type": "object" } } },
    "exploreEntrypointInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "entrypointId"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "entrypointId": { "$ref": "#/$defs/id" } } },
    "exploreEntrypointOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["entrypointId", "previousPageStateId", "pageStateId", "candidateRefs", "entrypointRefs", "entrypoints"], "properties": { "entrypointId": { "$ref": "#/$defs/id" }, "previousPageStateId": { "$ref": "#/$defs/pageStateId" }, "pageStateId": { "$ref": "#/$defs/pageStateId" }, "candidateRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "entrypointRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "entrypoints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["entrypointId", "kind", "label", "status"], "properties": { "entrypointId": { "$ref": "#/$defs/id" }, "kind": { "type": "string" }, "label": { "type": "string" }, "status": { "type": "string" } } } }, "route": { "type": "string" }, "title": { "type": "string" }, "activeTab": { "type": "string" }, "visibleText": { "type": "string" }, "structureSummary": { "type": "object" }, "networkSummary": { "type": "object" } } },
    "inspectObjectInput": { "type": "object", "additionalProperties": false, "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "candidateId": { "$ref": "#/$defs/id" } }, "oneOf": [{ "required": ["objectId"] }, { "required": ["candidateId"] }] },
    "inspectObjectOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }, { "if": { "properties": { "rebindStatus": { "const": "matched" } }, "required": ["rebindStatus"] }, "then": { "required": ["objectId", "objectKind", "potentialRules", "controls", "lists"] } }, { "if": { "properties": { "rebindStatus": { "const": "changed" } }, "required": ["rebindStatus"] }, "then": { "required": ["replacementCandidateRef"] } }], "required": ["verificationRef", "rebindStatus", "candidateCount", "matchedDimensions", "changedDimensions"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "objectKind": { "type": "string" }, "potentialRules": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/rule" } }, "controls": { "type": "array", "items": { "type": "object" } }, "lists": { "type": "array", "items": { "type": "object" } }, "replacementCandidateRef": { "$ref": "#/$defs/id" }, "verificationRef": { "$ref": "#/$defs/id" }, "rebindStatus": { "enum": ["matched", "not_found", "ambiguous", "changed"] }, "candidateCount": { "type": "integer", "minimum": 0 }, "matchedDimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "changedDimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "beginCaseInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "rule", "kind", "purpose", "plannedCoverageDimensions"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "rule": { "$ref": "#/$defs/rule" }, "kind": { "enum": ["negative", "boundary", "invalid", "exception", "happy_prerequisite", "observation"] }, "purpose": { "type": "string", "minLength": 1 }, "plannedCoverageDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "syntheticInputs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fieldRef", "valueClass"], "properties": { "fieldRef": { "$ref": "#/$defs/id" }, "valueClass": { "enum": ["valid", "empty", "malformed", "boundary_low", "boundary_high", "oversized", "special_characters", "synthetic_other"] }, "valueDescription": { "type": "string", "minLength": 1 } } } } } },
    "beginCaseOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["caseId", "baselinePageStateRef", "status"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "baselinePageStateRef": { "$ref": "#/$defs/pageStateId" }, "status": { "const": "planned" } } },
    "performActionInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "caseId", "objectId", "type", "intent", "parameters"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "caseId": { "$ref": "#/$defs/caseId" }, "objectId": { "$ref": "#/$defs/objectId" }, "type": { "$ref": "#/$defs/actionType" }, "intent": { "type": "string", "minLength": 1 }, "parameters": { "type": "object" } } },
    "performActionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["beforePageStateRef", "afterPageStateRef", "resultStatus", "actionId", "safetyOutcome"], "properties": { "beforePageStateRef": { "$ref": "#/$defs/pageStateId" }, "afterPageStateRef": { "$ref": "#/$defs/pageStateId" }, "resultStatus": { "enum": ["succeeded", "rejected", "result_unknown"] }, "actionId": { "$ref": "#/$defs/id" }, "safetyOutcome": { "enum": ["allowed", "blocked", "not_attempted"] }, "requestObservationRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } },
    "restoreCaseInput": { "type": "object", "additionalProperties": false, "required": ["caseId", "pageStateId", "objectId", "fallback"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "pageStateId": { "$ref": "#/$defs/pageStateId" }, "objectId": { "$ref": "#/$defs/objectId" }, "fallback": { "const": "refresh_and_replay_safe_entrypoints" } } },
    "restoreCaseOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["caseId", "finalStatus"], "properties": { "caseId": { "$ref": "#/$defs/caseId" }, "finalStatus": { "enum": ["restored", "uncertain", "failed"] } } },
    "inspectSourceInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "queries", "maxSnippets"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "queries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "maxSnippets": { "type": "integer", "minimum": 1, "maximum": 32 } } },
    "inspectSourceOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["sourceBindingStatus"], "properties": { "sourceBindingStatus": { "enum": ["verified", "unverified", "not_found"] }, "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "captureEvidenceInput": { "type": "object", "additionalProperties": false, "required": ["pageStateId", "objectId"], "properties": { "pageStateId": { "$ref": "#/$defs/pageStateId" }, "objectId": { "$ref": "#/$defs/objectId" }, "caseId": { "$ref": "#/$defs/caseId" }, "includeRawVisual": { "type": "boolean" } } },
    "captureEvidenceOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["evidenceId", "evidence"], "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "screenshotRef": { "$ref": "#/$defs/id" }, "evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "payload"], "properties": { "kind": { "enum": ["runtime_dom", "runtime_visual", "runtime_interaction", "network_observation", "source", "location", "diagnostic"] }, "payload": { "type": "object", "additionalProperties": false, "required": ["payloadType", "content"], "properties": { "payloadType": { "enum": ["text", "json", "dom_fragment", "network_summary", "image_metadata", "diagnostic"] }, "content": {} } }, "sourceBinding": { "type": "object" }, "visual": { "type": "object", "additionalProperties": false, "required": ["status", "sanitizationStatus"], "properties": { "status": { "enum": ["captured", "not_located", "ambiguous", "rejected"] }, "sanitizationStatus": { "enum": ["sanitized", "not_performed", "failed"] } } } } } } },
    "getRuleContractInput": { "type": "object", "additionalProperties": false, "required": ["rule"], "properties": { "rule": { "$ref": "#/$defs/rule" } } },
    "getRuleContractOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["rule", "content", "contentDigest", "registryDigest"], "properties": { "rule": { "type": "object" }, "content": { "type": "string", "minLength": 1 }, "contentDigest": { "$ref": "../common.schema.json#/$defs/sha256" }, "registryDigest": { "$ref": "../common.schema.json#/$defs/sha256" } } },
    "getAuditProgressInput": { "type": "object", "additionalProperties": false },
    "getAuditProgressOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["scanStatus", "currentPageStateId", "visitedPageStateRefs", "entrypoints", "objects", "activeCases", "investigations", "pendingDecisionRefs"], "properties": { "scanStatus": { "type": "string" }, "currentPageStateId": { "$ref": "#/$defs/pageStateId" }, "visitedPageStateRefs": { "type": "array", "items": { "$ref": "#/$defs/pageStateId" } }, "entrypoints": { "type": "object" }, "objects": { "type": "array" }, "activeCases": { "type": "array" }, "investigations": { "type": "array" }, "pendingDecisionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "recordFindingsInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "rule", "findings"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "rule": { "$ref": "#/$defs/rule" }, "findings": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["dimension", "status", "reasonText", "evidenceRefs", "caseRefs"], "properties": { "dimension": { "type": "string", "minLength": 1 }, "status": { "enum": ["satisfied", "violated", "unresolved", "blocked", "conflicted"] }, "reasonText": { "type": "string", "minLength": 1 }, "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "caseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/caseId" } }, "supersedesRef": { "$ref": "#/$defs/id" } } } } } },
    "recordFindingsOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["findingRefs"], "properties": { "findingRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } } } },
    "prepareDecisionInput": { "type": "object", "additionalProperties": false, "required": ["objectId", "rule", "result", "reasonText", "findingRefs", "evidenceRefs", "caseRefs"], "properties": { "objectId": { "$ref": "#/$defs/objectId" }, "rule": { "$ref": "#/$defs/rule" }, "result": { "$ref": "#/$defs/decisionResult" }, "reasonText": { "type": "string", "minLength": 1 }, "blocker": { "$ref": "#/$defs/reason" }, "findingRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "evidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "caseRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/caseId" } }, "rawVisualRef": { "$ref": "#/$defs/id" }, "severity": { "$ref": "../common.schema.json#/$defs/severity" }, "title": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 } }, "allOf": [{ "if": { "properties": { "result": { "const": "issue_found" } }, "required": ["result"] }, "then": { "required": ["rawVisualRef", "severity", "title", "message", "impact", "recommendation"] } }, { "if": { "properties": { "result": { "const": "needs_review" } }, "required": ["result"] }, "then": { "required": ["blocker"] } }] },
    "prepareDecisionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["pendingDecisionId"], "properties": { "pendingDecisionId": { "$ref": "#/$defs/id" }, "screenshotRef": { "$ref": "#/$defs/id" } } },
    "commitDecisionInput": { "type": "object", "additionalProperties": false, "required": ["pendingDecisionId"], "properties": { "pendingDecisionId": { "$ref": "#/$defs/id" } } },
    "commitDecisionOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["assessmentId"], "properties": { "assessmentId": { "$ref": "#/$defs/id" }, "issueId": { "$ref": "#/$defs/id" } } },
    "getOperationInput": { "type": "object", "additionalProperties": false, "required": ["operationId"], "properties": { "operationId": { "$ref": "#/$defs/operationId" } } },
    "getOperationOutput": { "type": "object", "additionalProperties": false, "required": ["operationId", "status", "requestDigest"], "properties": { "operationId": { "$ref": "#/$defs/operationId" }, "status": { "enum": ["accepted", "running", "succeeded", "rejected", "failed_known", "result_unknown"] }, "requestDigest": { "$ref": "../common.schema.json#/$defs/sha256" }, "result": { "type": "object" }, "resultEvidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } } } },
    "completeAuditInput": { "type": "object", "additionalProperties": false, "required": ["visitedPageStateRefs", "processedObjectRefs", "processedEntrypointRefs", "skippedEntrypoints", "ruleSummaries", "unprocessedEntrypointRefs", "completionReason"], "properties": { "visitedPageStateRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/pageStateId" } }, "processedObjectRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/objectId" } }, "processedEntrypointRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "skippedEntrypoints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["entrypointId", "reason"], "properties": { "entrypointId": { "$ref": "#/$defs/id" }, "reason": { "$ref": "#/$defs/reason" } } } }, "ruleSummaries": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["rule", "assessmentCount", "resultCounts", "coverageComplete"], "properties": { "rule": { "$ref": "#/$defs/rule" }, "assessmentCount": { "type": "integer", "minimum": 0 }, "resultCounts": { "type": "object", "propertyNames": { "enum": ["issue_found", "scanned_no_issue", "not_applicable", "needs_review", "noise"] }, "additionalProperties": { "type": "integer", "minimum": 0 } }, "coverageComplete": { "type": "boolean" }, "reason": { "type": "string", "minLength": 1 } } } }, "unprocessedEntrypointRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "completionReason": { "type": "string", "minLength": 1 } } },
    "completeAuditOutput": { "allOf": [{ "$ref": "#/$defs/commonOutput" }], "required": ["scanStatus", "conclusionsValid"], "properties": { "scanStatus": { "enum": ["completed", "partial", "failed"] }, "conclusionsValid": { "type": "boolean" }, "ledgerPath": { "type": "string", "minLength": 1 }, "artifactPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } }
  }
}
