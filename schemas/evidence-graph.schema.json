{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/evidence-graph.schema.json",
  "title": "AssayerEvidenceGraphProjection",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidateCount", "coveredCandidateCount", "pendingCandidateIds", "coverageComplete", "rootCauseGroups"],
  "properties": {
    "candidateCount": {"type": "integer", "minimum": 0},
    "coveredCandidateCount": {"type": "integer", "minimum": 0},
    "pendingCandidateIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
    "coverageComplete": {"type": "boolean"},
    "rootCauseGroups": {
      "type": "array",
      "items": {"$ref": "#/$defs/rootCauseGroup"}
    },
    "workItems": {
      "type": "array",
      "items": {"$ref": "#/$defs/workItemCoverage"}
    }
  },
  "$defs": {
    "rootCauseGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["groupId", "candidateIds", "evidenceRefs", "affectedDimensions"],
      "properties": {
        "groupId": {"$ref": "common.schema.json#/$defs/nonEmptyString"},
        "candidateIds": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
        "evidenceRefs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
        "affectedDimensions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true}
      }
    },
    "workItemCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "candidateCount", "coveredCandidateCount", "pendingCandidateIds", "coverageComplete"],
      "properties": {
        "workItemId": {"$ref": "common.schema.json#/$defs/entityId"},
        "candidateCount": {"type": "integer", "minimum": 0},
        "coveredCandidateCount": {"type": "integer", "minimum": 0},
        "pendingCandidateIds": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}, "uniqueItems": true},
        "coverageComplete": {"type": "boolean"}
      }
    }
  }
}
