{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/result-conformance.schema.json",
  "title": "AssayerResultConformanceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "issues"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "common.schema.json#/$defs/entityId" },
    "status": { "enum": ["passed", "failed"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "invariant", "message", "nextAction"],
        "properties": {
          "code": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "invariant": { "type": "string", "pattern": "^RCV1-[A-Z0-9-]+$" },
          "message": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "nextAction": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        }
      }
    }
  }
}
