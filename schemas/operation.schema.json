{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/operation.schema.json",
  "title": "Operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId", "scanId", "requestId", "tool", "operationKind", "idempotencyKey", "requestDigest", "status", "acceptedAt", "acceptedAtRevision"],
  "properties": {
    "operationId": { "$ref": "common.schema.json#/$defs/entityId" },
    "scanId": { "$ref": "common.schema.json#/$defs/entityId" },
    "requestId": { "$ref": "common.schema.json#/$defs/entityId" },
    "caseRef": { "$ref": "common.schema.json#/$defs/entityId" },
    "tool": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "operationKind": { "enum": ["bootstrap", "read", "browser_action", "recovery", "finding_record", "decision_preparation", "decision_commit", "lifecycle"] },
    "idempotencyKey": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "requestDigest": { "$ref": "common.schema.json#/$defs/sha256" },
    "status": { "enum": ["accepted", "running", "succeeded", "rejected", "failed_known", "result_unknown"] },
    "acceptedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "acceptedAtRevision": { "$ref": "common.schema.json#/$defs/runRevision" },
    "endedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "resultEvidenceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/entityId" } },
    "reason": { "$ref": "common.schema.json#/$defs/reason" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["succeeded", "rejected", "failed_known", "result_unknown"] } }, "required": ["status"] },
      "then": { "required": ["endedAt"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["rejected", "failed_known", "result_unknown"] } }, "required": ["status"] },
      "then": { "required": ["reason"] }
    }
  ]
}
