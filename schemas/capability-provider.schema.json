{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/capability-provider.schema.json",
  "title": "AssayerCapabilityProviderDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["providerId", "version", "platformApiVersion", "capabilities", "scopeSchema", "authorization", "limits", "failurePolicy", "algorithmVersions"],
  "properties": {
    "providerId": { "$ref": "common.schema.json#/$defs/entityId" },
    "version": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "platformApiVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "capabilities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "accessMode", "evidenceKinds"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "version": { "$ref": "common.schema.json#/$defs/semanticVersion" },
          "accessMode": { "enum": ["read_only", "controlled_action"] },
          "evidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }
        }
      }
    },
    "scopeSchema": { "type": "object" },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["userScopeRequired", "secretHandling"],
      "properties": {
        "userScopeRequired": { "type": "boolean" },
        "secretHandling": { "enum": ["none", "opaque_handle_only"] }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeoutMs", "maxBytes", "maxItems", "maxConcurrency"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "failurePolicy": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "retry"],
        "properties": {
          "code": { "enum": ["capability_unavailable", "authorization_denied", "timeout", "budget_exceeded", "source_changed", "stale_state", "source_error", "result_unknown"] },
          "retry": { "enum": ["never", "safe_with_same_request", "resolve_unknown_first"] }
        }
      }
    },
    "algorithmVersions": {
      "type": "object",
      "additionalProperties": { "$ref": "common.schema.json#/$defs/semanticVersion" }
    }
  }
}
