{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/canonical-result.schema.json",
  "title": "AssayerCanonicalAuditResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "status", "conclusionValidity", "coverage", "outcomes", "findings", "needsReview", "unverified", "failures", "performance", "trace"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["runId", "pluginId", "pluginVersion", "checkId", "checkVersion"],
      "properties": {
        "runId": { "$ref": "common.schema.json#/$defs/entityId" },
        "pluginId": { "$ref": "common.schema.json#/$defs/entityId" },
        "pluginVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
        "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
        "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" }
      }
    },
    "status": { "enum": ["completed", "partial", "failed"] },
    "conclusionValidity": { "$ref": "common.schema.json#/$defs/conclusionValidity" },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["discovered", "processed", "skipped", "unprocessed", "complete"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "processed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unprocessed": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "actionability": { "enum": ["complete", "partial", "not_declared"] },
    "remediations": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://assayer.dev/schemas/actionable-result.schema.json#/$defs/remediation" },
          {
            "type": "object",
            "required": ["workItemId", "checkId", "checkVersion"],
            "properties": {
              "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
              "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
              "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" }
            }
          }
        ]
      }
    },
    "evidenceClaims": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceClaim" }
    },
    "evidenceGraph": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceGraphItem" }
    },
    "needsReview": { "type": "array", "items": { "$ref": "#/$defs/reviewItem" } },
    "unverified": { "type": "array", "items": { "$ref": "#/$defs/unverifiedItem" } },
    "failures": { "type": "array", "items": { "$ref": "#/$defs/failure" } },
    "performance": {
      "type": "object", "additionalProperties": false,
      "required": ["wallClock", "agentWait", "transport", "host", "provider"],
      "properties": {
        "wallClock": { "$ref": "#/$defs/timing" },
        "agentWait": { "$ref": "#/$defs/timing" },
        "transport": { "$ref": "#/$defs/timing" },
        "host": { "$ref": "#/$defs/timing" },
        "provider": { "$ref": "#/$defs/timing" },
        "details": { "type": "object" }
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["ledgerRef", "ledgerDigest"],
      "properties": {
        "ledgerRef": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "ledgerDigest": { "$ref": "common.schema.json#/$defs/sha256" },
        "eventsRef": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "diagnosticsRef": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "domainExtension": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "schemaVersion", "data"],
      "properties": {
        "schemaId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "schemaVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
        "data": { "type": "object" }
      }
    }
  },
  "$defs": {
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "sourceClaimId", "workItemId", "kind", "evidenceRefs", "conclusion"],
      "properties": {
        "claimId": { "$ref": "common.schema.json#/$defs/entityId" },
        "sourceClaimId": { "$ref": "common.schema.json#/$defs/entityId" },
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "kind": { "enum": ["direct", "absence", "derived", "external_unverified"] },
        "evidenceRefs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/entityId" }
        },
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceRef", "startLine", "endLine"],
          "properties": {
            "sourceRef": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "documentPath": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
            "sourceDigest": { "$ref": "common.schema.json#/$defs/sha256" },
            "startLine": { "type": "integer", "minimum": 1 },
            "endLine": { "type": "integer", "minimum": 1 }
          }
        },
        "searchedFor": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "observed": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "derivation": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "unavailableReason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "conclusion": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "absence" } } }, "then": { "required": ["scope", "searchedFor"], "properties": { "searchedFor": { "minItems": 1 } } } },
        { "if": { "properties": { "kind": { "const": "derived" } } }, "then": { "required": ["derivation"] } },
        { "if": { "properties": { "kind": { "const": "external_unverified" } } }, "then": { "required": ["unavailableReason"] } }
      ]
    },
    "timing": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "durationMs"],
          "properties": {
            "status": { "const": "measured" },
            "durationMs": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "unavailable" },
            "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "checkId", "checkVersion", "result", "reason", "receiptId"],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
        "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
        "result": { "$ref": "common.schema.json#/$defs/decisionResult" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "receiptId": { "$ref": "common.schema.json#/$defs/entityId" }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["findingId", "workItemId", "checkId", "checkVersion", "dimension", "status"],
      "properties": {
        "findingId": { "$ref": "common.schema.json#/$defs/entityId" },
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
        "checkVersion": { "$ref": "common.schema.json#/$defs/semanticVersion" },
        "dimension": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "status": { "enum": ["satisfied", "violated", "unresolved", "blocked", "conflicted"] },
        "reason": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entityId" }, "uniqueItems": true },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["sourceChunkId", "startLine", "endLine"],
            "properties": {
              "sourceChunkId": { "$ref": "common.schema.json#/$defs/entityId" },
              "documentPath": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "sourceDigest": { "$ref": "common.schema.json#/$defs/sha256" },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "excerpt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
            }
          }
        },
        "sourceFindingId": { "$ref": "common.schema.json#/$defs/entityId" },
        "gap": { "type": "string" },
        "impact": { "type": "string" },
        "recommendation": { "type": "string" },
        "affectedElements": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "owner": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "nextAction": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "confidence": { "enum": ["high", "medium", "low"] }
      }
    },
    "reviewItem": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "checkId", "reason", "unresolvedDimensions", "nextAction"],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "checkId": { "$ref": "common.schema.json#/$defs/ruleId" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "unresolvedDimensions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } },
        "nextAction": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
      }
    },
    "unverifiedItem": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "reason", "missingEvidence"],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "missingEvidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }
      }
    },
    "evidenceGraphItem": {
      "type": "object", "additionalProperties": false,
      "required": ["workItemId", "candidateCount", "coveredCandidateCount", "pendingCandidateIds", "coverageComplete", "rootCauseGroups"],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "coveredCandidateCount": { "type": "integer", "minimum": 0 },
        "pendingCandidateIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
        "coverageComplete": { "type": "boolean" },
        "rootCauseGroups": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["groupId", "candidateIds", "evidenceRefs", "affectedDimensions"],
            "properties": {
              "groupId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
              "candidateIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
              "evidenceRefs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
              "affectedDimensions": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "owner", "retryable"],
      "properties": {
        "workItemId": { "$ref": "common.schema.json#/$defs/entityId" },
        "code": { "$ref": "common.schema.json#/$defs/reason/properties/code" },
        "message": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "owner": { "enum": ["environment", "provider", "platform", "agent", "plugin", "transport", "target", "unattributed"] },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "coverage": { "properties": { "complete": { "const": true } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "conclusionValidity": { "const": "invalidated" },
          "outcomes": { "maxItems": 0 }
        }
      }
    }
  ]
}
