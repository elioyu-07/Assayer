{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/schemas/audit-object.schema.json",
  "title": "AuditObject",
  "type": "object",
  "additionalProperties": false,
  "required": ["objectId", "scanId", "pageStateRef", "kind", "status", "runtimeObserved", "identity", "rebindStatus", "lastVerifiedAtRevision", "location", "potentialRules", "assessmentRefs", "observedAt"],
  "properties": {
    "objectId": { "$ref": "common.schema.json#/$defs/entityId" },
    "scanId": { "$ref": "common.schema.json#/$defs/entityId" },
    "pageStateRef": { "$ref": "common.schema.json#/$defs/entityId" },
    "kind": {
      "enum": ["button", "field", "form", "table", "table_column", "filter_region", "import_region", "error_region", "attachment_region", "business_region", "unknown"]
    },
    "status": { "enum": ["discovered", "eligible", "investigating", "decided", "blocked"] },
    "runtimeObserved": { "const": true },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostLocatorId", "fingerprint", "algorithmVersion"],
      "properties": {
        "hostLocatorId": { "$ref": "common.schema.json#/$defs/entityId" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/sha256" },
        "algorithmVersion": { "$ref": "common.schema.json#/$defs/algorithmVersion" },
        "role": { "type": "string" },
        "accessibleName": { "type": "string" },
        "visibleText": { "type": "string" }
      }
    },
    "rebindStatus": { "enum": ["matched", "not_found", "ambiguous", "changed"] },
    "lastVerifiedAtRevision": { "$ref": "common.schema.json#/$defs/runRevision" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundingBox", "visible"],
      "properties": {
        "boundingBox": { "$ref": "common.schema.json#/$defs/boundingBox" },
        "visible": { "type": "boolean" },
        "viewportWidth": { "type": "integer", "minimum": 1 },
        "viewportHeight": { "type": "integer", "minimum": 1 }
      }
    },
    "potentialRules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/ruleRef" }
    },
    "assessmentRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/entityId" }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["controlRef", "kind", "semanticAction", "visible", "disabled", "valueClass"],
        "properties": {
          "controlRef": { "$ref": "common.schema.json#/$defs/entityId" },
          "kind": { "enum": ["input", "select", "textarea", "button", "other"] },
          "semanticAction": { "enum": ["query", "reset", "filter_input", "other"] },
          "visible": { "type": "boolean" }, "disabled": { "type": "boolean" },
          "valueClass": { "enum": ["empty", "non_empty", "unknown"] }
        }
      }
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["listRef", "kind", "visible", "relationship"],
        "properties": {
          "listRef": { "$ref": "common.schema.json#/$defs/entityId" },
          "kind": { "enum": ["table", "grid", "list", "unknown"] },
          "visible": { "type": "boolean" },
          "relationship": { "enum": ["same_container", "aria_owned", "nearby", "unknown"] }
        }
      }
    },
    "relatedObjectRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/entityId" }
    },
    "observedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "blockedReason": { "$ref": "common.schema.json#/$defs/reason" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "required": ["blockedReason"] }
    }
  ]
}
